default_platform(:ios)

# Espejo local del Fastfile de Android. El camino oficial de release es
# .github/workflows/ios-ipa.yml (CI, sin toolchain local); estas lanes son para
# cuando alguien con Xcode instalado quiere iterar en su Mac.
#
# Nombres de metodo: desde Xcode 15.4 "ad-hoc" y "app-store" estan deprecados y
# Xcode 26 los RECHAZA. Los validos son "release-testing" y "app-store-connect".

platform :ios do
  desc "Build sin firmar (.ipa para re-firmar con AltStore/Sideloadly)"
  lane :unsigned do
    gym(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      skip_codesigning: true,
      skip_package_ipa: false,
      output_name: "KiramoPay-unsigned.ipa",
      output_directory: "./build",
    )
  end

  desc "Build Ad Hoc firmado (solo instala en los UDID del perfil)"
  lane :adhoc do
    gym(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "release-testing",
      output_name: "KiramoPay.ipa",
      output_directory: "./build",
    )
  end

  desc "Build de distribucion y subida a TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_KEY_PATH"],
    )
    gym(
      workspace: "App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store-connect",
      output_name: "KiramoPay.ipa",
      output_directory: "./build",
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
