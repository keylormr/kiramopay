<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: kiramopay:// scheme -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kiramopay" />
            </intent-filter>

            <!-- Deep link: https://app.kiramopay.com -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.kiramopay.com" />
            </intent-filter>

        </activity>

        <!-- Avisos de FCM: el icono de la barra de estado tiene que ser
             monocromo (Android pinta solo la silueta; el icono de colores del
             launcher saldria como un cuadrado blanco), el color de acento, y
             el canal que crea la app al activar los avisos. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_kiramo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/kiramo_aviso" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos" />
        <!-- Sin token de FCM hasta que la persona active los avisos: el
             plugin lo enciende en register() y lo apaga en unregister(). -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- El escaner QR usa getUserMedia dentro del WebView: sin CAMERA aqui,
         Capacitor no puede conceder la peticion y la camara falla con
         "could not open the camera". El permiso de runtime lo pide el
         sistema la primera vez; la feature va como no-requerida para no
         excluir dispositivos sin camara en Play. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 13 en adelante pide permiso para mostrar avisos; la app lo
         solicita cuando la persona los activa en Perfil. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
